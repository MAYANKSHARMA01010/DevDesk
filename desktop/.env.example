# ==============================================================================
# DevDesk Desktop Electron Shell Configuration Example
# ==============================================================================
# Set this to your hosted backend URL when packaging for DMG!
# e.g. BACKEND_URL=https://api.devdesk.yourdomain.com
BACKEND_URL=http://localhost:5001
NEXT_PUBLIC_BACKEND_URL=http://localhost:5001

# Frontend local dev server URL
ELECTRON_START_URL=http://localhost:3000

# Set to true if you are using a remote hosted backend
HOSTED_BACKEND=false
