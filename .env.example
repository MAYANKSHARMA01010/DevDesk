# ==============================================================================
# DevDesk Global Master Configuration Example
# ==============================================================================
# Copy this file to .env and adjust the variables to fit your environment.
# Change the NEXT_PUBLIC_BACKEND_URL to your hosted backend link when deploying.
# ==============================================================================

# Target Backend Server URL (Consumed by Frontend, Desktop, and API Tester)
NEXT_PUBLIC_BACKEND_URL=http://localhost:5001
BACKEND_URL=http://localhost:5001

# Backend Server Listening Configuration (Local mode)
PORT=5001
HOST=127.0.0.1

# Frontend UI Configuration
NEXT_PUBLIC_PORT=3000
FRONTEND_PORT=3000
ELECTRON_START_URL=http://localhost:3000

# Packaging Options
# Set to 'false' for thin DMG (Frontend + Electron only, connects to hosted backend)
PACKAGE_BACKEND=false

# Application Branding
NEXT_PUBLIC_APP_NAME=DevDesk
NEXT_PUBLIC_APP_VERSION=1.0.0
